{
  "name": "memory-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "npm run db:migrate && node build/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:kit": "drizzle-kit migrate"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-orm": "^0.45.3",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tanstack/svelte-table": "^9.2.4",
    "@types/node": "^22.20.4",
    "bits-ui": "^2.19.4",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "layerchart": "^2.5.1",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "shadcn-svelte": "^1.7.0",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "sveltekit-superforms": "^3.0.0-next.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^8.3.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.1"
    },
    "formsnap": {
      "sveltekit-superforms": "$sveltekit-superforms"
    },
    "runed": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
